{
  "rules": {
    "rooms": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email == 'TEACHER_EMAIL@gmail.com'",
      ".write": "auth != null && auth.token.email_verified == true && auth.token.email == 'TEACHER_EMAIL@gmail.com'",
      "$code": {
        ".read": "auth != null",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($code).child('status').exists() && root.child('rooms').child($code).child('status').val() != 'ended'",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 24 && newData.child('score').isNumber())"
          }
        },
        "answers": {
          "$round": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid && !data.exists() && root.child('rooms').child($code).child('status').val() == 'round' && root.child('rooms').child($code).child('round').child('key').val() == $round",
              ".validate": "newData.child('points').isNumber() && newData.child('points').val() <= 1000 && newData.child('ms').isNumber()"
            }
          }
        }
      }
    },
    "history": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email == 'TEACHER_EMAIL@gmail.com'",
      ".write": "auth != null && auth.token.email_verified == true && auth.token.email == 'TEACHER_EMAIL@gmail.com'"
    },
    "scores": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email_verified == true && auth.token.email == 'TEACHER_EMAIL@gmail.com'",
      ".indexOn": ["event", "key"],
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() == auth.uid",
        ".validate": "newData.hasChildren(['name', 'key', 'event', 'cat', 'level', 'dur', 'score', 'misses', 'uid', 'ts']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 24 && newData.child('key').isString() && newData.child('key').val().length <= 24 && newData.child('event').isString() && newData.child('event').val().length <= 20 && newData.child('dur').isNumber() && newData.child('dur').val() >= 30 && newData.child('dur').val() <= 120 && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= newData.child('dur').val() * 3 && newData.child('misses').isNumber() && newData.child('ts').isNumber() && newData.child('ts').val() <= now"
      }
    }
  }
}
